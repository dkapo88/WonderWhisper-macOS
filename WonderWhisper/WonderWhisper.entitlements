<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox disabled: distributed via Developer ID, not the Mac App Store.
	     The app needs unsandboxed Accessibility (global hotkeys + text insertion),
	     screen capture, and Apple Events, which are awkward or impossible to grant
	     inside the sandbox. Trade-off: cannot ship to the Mac App Store while false. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.screen-capture</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Needed for AppleScript Automation (System Events keystroke) -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- MLX compiles/loads Metal kernels at runtime. Debug and XCTest hosts
	     inject get-task-allow, which is why Qwen works there and garbles in
	     the notarized Developer ID export. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- mlx-swift_Cmlx.bundle is a resource bundle, not a signed nested
	     executable. Hardened Runtime library validation blocks it unless
	     XCTest injects get-task-allow. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
